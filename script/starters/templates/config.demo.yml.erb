# The live demo's settings. Only the Pages workflow of <%= starter.repo %>
# layers this file over _config.yml, so a repository created from this template, or a fork, builds without it.
# You may delete it.
modootoday:
  showcase:
    enabled: true
    style: <%= starter.style %>
    starter: <%= starter.name %>
    docs_url: <%= starter.docs_url %>
    use_url: <%= starter.generate_url %>
