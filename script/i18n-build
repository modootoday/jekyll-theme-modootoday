#!/usr/bin/env ruby
# frozen_string_literal: true
# Generates the Liquid catalogs the theme ships from i18n/<lang>.yml (English canonical).
#   _includes/modootoday/i18n/<lang>.html  one language packed into a single captured string (loaded lazily, only
#                                          the active one; cheap to parse, since Jekyll 3 re-parses includes per render)
#   _includes/modootoday/i18n.html         loader: one assign per key resolving site _data/i18n/<lang>.yml, then the
#                                          theme catalog for the page language, then English
#   _includes/modootoday/i18n/name.html    endonym of include.code (for language menus)
# Usage: script/i18n-build [--check]   (--check exits 1 when the generated files are out of date)
require "yaml"
ROOT = File.expand_path("..", __dir__)
OUT = "#{ROOT}/_includes/modootoday/i18n"
def leaves(h, pre = nil) = h.is_a?(Hash) ? h.flat_map { |k, v| leaves(v, [pre, k].compact.join(".")) } : [[pre, h.to_s]]
def var(k) = "mt_t_#{k.tr('.', '_')}"
def lit(v)
  abort "i18n: value contains both quote kinds: #{v}" if v.include?('"') && v.include?("'")
  v.include?('"') ? "'#{v}'" : "\"#{v}\""
end
langs = YAML.safe_load(File.read("#{ROOT}/i18n/languages.yml")).map { |l| l["code"] }
reg = leaves(YAML.safe_load(File.read("#{ROOT}/i18n/en.yml"))).to_h
files = {}
cats = langs.to_h do |l|
  h = leaves(YAML.safe_load(File.read("#{ROOT}/i18n/#{l}.yml"))).to_h
  abort "i18n/#{l}.yml: keys differ from en.yml: #{((reg.keys - h.keys) + (h.keys - reg.keys)).join(', ')}" unless h.keys.sort == reg.keys.sort
  ph = ->(v) { v.scan(/\[(?:n|total|section)\]/).sort } # placeholders: [n] [total] [section]
  h.each { |k, v| abort "i18n/#{l}.yml: #{k} placeholders differ from English" unless ph[v] == ph[reg[k]] }
  [l, h]
end
SEP = "\u001f" # unit separator: never in a translation (checked below)
gen = "{%- comment -%}Generated by script/i18n-build from i18n/LANG.yml; do not edit.{%- endcomment -%}\n"
keys = reg.keys - %w[language direction]
def pack(h, keys, name)
  vals = keys.map { |k| h[k] }
  vals.each { |v| abort "i18n: value has a forbidden sequence ({ } or separator): #{v}" if v.empty? || v.match?(/[{}]|#{SEP}/) }
  "{%- capture _tc -%}#{vals.join(SEP)}{%- endcapture -%}{%- assign #{name} = _tc | split: \"#{SEP}\" -%}"
end
cats.each do |l, h|
  next if l == "en"
  # direction is emitted only where it differs from what the layout derives from the code (ur-Latn: ltr).
  rtl_code = %w[ar fa he ur yi ps sd ug dv ckb].include?(l.split("-").first)
  dir = (h["direction"] == "rtl") == rtl_code ? "" : "{%- assign _tdir = #{lit(h['direction'])} -%}"
  files["#{OUT}/#{l}.html"] = gen.sub("LANG", l) + pack(h, keys, "_tx") + dir + "\n"
end
files["#{OUT}/name.html"] = gen.sub("LANG", "*") + "{%- case include.code -%}" +
  cats.map { |l, h| "{%- when #{lit(l)} -%}#{h['language']}" }.join + "{%- else -%}{{ include.code }}{%- endcase -%}\n"
others = langs - ["en"]
loader = <<~LIQ
  {%- comment -%}Generated by script/i18n-build; do not edit. Sets mt_t_<key> for the page language, per key:
    site.data.i18n[lang], then the theme catalog for the language (exact code, else its first subtag; loaded
    lazily from i18n/<code>.html), then English. mt_t_direction is set only from the site catalog or where the
    theme catalog differs from the layout's code-based default (e.g. ur-Latn ltr), never from English.{%- endcomment -%}
  {%- assign _tl = include.lang | default: page.lang | default: site.lang | default: "en" -%}
  {%- unless mt_t_lang == _tl -%}
  {%- assign mt_t_lang = _tl -%}
  #{pack(cats["en"], keys, "_te")}
  {%- assign _tx = nil -%}{%- assign _tdir = nil -%}{%- assign _tf = nil -%}
  {%- assign _tb = _tl | split: "-" | first -%}
  {%- assign _tk = " " | append: _tl | append: " " -%}{%- assign _tbk = " " | append: _tb | append: " " -%}
  {%- if " #{others.join(' ')} " contains _tk -%}{%- assign _tf = _tl -%}
  {%- else -%}{%- case _tb -%}#{(others - ["ur-Latn"]).group_by { |l| l.split("-").first }.select { |b, ls| b != ls.first }.map { |b, ls| "{%- when #{lit(b)} -%}{%- assign _tf = #{lit(ls.first)} -%}" }.join}{%- else -%}{%- if " #{(others - ['ur-Latn']).join(' ')} " contains _tbk -%}{%- assign _tf = _tb -%}{%- endif -%}{%- endcase -%}{%- endif -%}
  {%- if _tf -%}{%- include modootoday/i18n/{{ _tf }}.html -%}{%- endif -%}
  {%- assign _ts = site.data.i18n[_tl] -%}
  #{keys.each_with_index.map { |k, i| "{%- assign #{var(k)} = _ts.#{k} | default: _tx[#{i}] | default: _te[#{i}] -%}" }.join("\n")}
  {%- assign mt_t_direction = _ts.direction | default: _tdir -%}
  {%- endunless -%}
LIQ
files["#{ROOT}/_includes/modootoday/i18n.html"] = loader
t = <<~LIQ
  {%- comment -%}Theme string by key: {% include modootoday/t.html key="nav.label" %} (optional n= / name= fill %{n} / %{name}).
    Resolution: site _data/i18n/<lang>.yml, then the theme catalog for the language, then English. Generated by script/i18n-build.{%- endcomment -%}
  {%- include modootoday/i18n.html -%}
  {%- case include.key -%}#{reg.keys.reject { |k| k == "language" }.map { |k| "{%- when #{lit(k)} -%}{%- assign _tv = #{var(k)} -%}" }.join}{%- when "language" -%}{%- capture _tv -%}{%- include modootoday/i18n/name.html code=mt_t_lang -%}{%- endcapture -%}{%- assign _tv = site.data.i18n[mt_t_lang].language | default: _tv -%}{%- else -%}{%- assign _tv = include.key -%}{%- endcase -%}
  {%- if include.n -%}{%- assign _tv = _tv | replace: "%{n}", include.n -%}{%- endif -%}
  {%- if include.name -%}{%- assign _tv = _tv | replace: "%{name}", include.name -%}{%- endif -%}
  {{- _tv -}}
LIQ
files["#{ROOT}/_includes/modootoday/t.html"] = t
stale = files.reject { |f, c| File.exist?(f) && File.read(f) == c }.keys
if ARGV.include?("--check")
  stale += Dir.glob("#{OUT}/*.html").reject { |f| files.key?(f) }
  abort "out of date (run script/i18n-build): #{stale.map { |f| f.delete_prefix("#{ROOT}/") }.join(', ')}" unless stale.empty?
  puts "i18n catalogs up to date (#{langs.size} languages, #{reg.size} keys)"
else
  Dir.mkdir(OUT) unless Dir.exist?(OUT)
  files.each { |f, c| File.write(f, c) }
  puts "wrote #{files.size} files (#{langs.size} languages, #{reg.size} keys)"
end
