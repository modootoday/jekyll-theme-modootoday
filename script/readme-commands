#!/usr/bin/env ruby
# frozen_string_literal: true
# Regenerates the "Commands" tables in README.md, README.ko.md and README.ja.md, and the options of the docs Command line pages
# (docs/reference/cli*.md, between the page-list markers), from `--help=markdown` of each executable (the OPTIONS
# lists in lib/modootoday/{check,stubs}/cli.rb). `--check` only reports drift (exit 1); test/project/readme_test.rb runs it.
require "open3"
require_relative "../lib/modootoday/markdown"
root = File.expand_path("..", __dir__)
TABLES = { "commands" => "exe/modootoday-check", "stubs" => "exe/modootoday-stubs" }.freeze
USAGE = { "commands" => "modootoday-check SRC SITE [options]", "stubs" => "modootoday-stubs SRC [options]" }.freeze
tables = TABLES.to_h do |mark, exe|
  table, st = Open3.capture2(RbConfig.ruby, File.join(root, exe), "--help=markdown")
  abort "#{exe} --help=markdown failed" unless st.success?
  [mark, table]
end
blocks = tables.to_h do |mark, table|
  begin_m = "<!-- #{mark}:begin (generated by script/readme-commands; do not edit) -->"
  [mark, [/#{Regexp.escape(begin_m)}\n.*?#{Regexp.escape("<!-- #{mark}:end -->")}/m, "#{begin_m}\n#{table}<!-- #{mark}:end -->"]]
end
b, e = Modootoday::Markdown::INDEX_MARK % "begin", Modootoday::Markdown::INDEX_MARK % "end"
cli = tables.map { |mark, table| "### #{USAGE[mark].split.first}\n\n`#{USAGE[mark]}`\n\n#{Modootoday::Markdown.plain_badge_prefixes(table)}" }.join("\n")
drift = []
write = lambda do |name, src, out|
  next if out == src
  drift << name
  File.write(File.join(root, name), out) unless ARGV.include?("--check")
end
%w[README.md README.ko.md README.ja.md].each do |name|
  src = File.read(File.join(root, name))
  out = blocks.reduce(src) do |s, (mark, (re, block))|
    abort "#{name}: #{mark} markers missing" unless s.match?(re)
    s.sub(re) { block }
  end
  write.call(name, src, out)
end
Dir.glob("docs/reference/cli{,.*}.md", base: root).sort.each do |name|
  src = File.read(File.join(root, name))
  abort "#{name}: page-list markers missing" unless src.include?(b) && src.include?(e)
  write.call(name, src, src.sub(/#{Regexp.escape(b)}.*?#{Regexp.escape(e)}/m) { "#{b}\n#{cli}#{e}" })
end
if ARGV.include?("--check") && drift.any?
  warn "commands tables out of date in #{drift.join(', ')}: run script/readme-commands"
  exit 1
end
puts drift.empty? ? "commands tables up to date" : "updated #{drift.join(', ')}"
