#!/usr/bin/env ruby
# frozen_string_literal: true
# Regenerates the "Commands" tables in README.md and README.ko.md from `--help=markdown` of each executable
# (the OPTIONS lists in lib/modootoday/{check,stubs}/cli.rb). `--check` only reports drift (exit 1); test/project/readme_test.rb runs it.
require "open3"
root = File.expand_path("..", __dir__)
TABLES = { "commands" => "exe/modootoday-check", "stubs" => "exe/modootoday-stubs" }.freeze
blocks = TABLES.to_h do |mark, exe|
  table, st = Open3.capture2(RbConfig.ruby, File.join(root, exe), "--help=markdown")
  abort "#{exe} --help=markdown failed" unless st.success?
  begin_m = "<!-- #{mark}:begin (generated by script/readme-commands; do not edit) -->"
  [mark, [/#{Regexp.escape(begin_m)}\n.*?#{Regexp.escape("<!-- #{mark}:end -->")}/m, "#{begin_m}\n#{table}<!-- #{mark}:end -->"]]
end
drift = []
%w[README.md README.ko.md].each do |name|
  path = File.join(root, name)
  src = File.read(path)
  out = blocks.reduce(src) do |s, (mark, (re, block))|
    abort "#{name}: #{mark} markers missing" unless s.match?(re)
    s.sub(re) { block }
  end
  next if out == src
  drift << name
  File.write(path, out) unless ARGV.include?("--check")
end
if ARGV.include?("--check") && drift.any?
  warn "README commands table out of date in #{drift.join(', ')}: run script/readme-commands"
  exit 1
end
puts drift.empty? ? "README commands tables up to date" : "updated #{drift.join(', ')}"
