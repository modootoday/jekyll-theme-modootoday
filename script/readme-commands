#!/usr/bin/env ruby
# frozen_string_literal: true
# Regenerates the "Commands" table in README.md and README.ko.md from `modootoday-check --help=markdown`
# (the OPTIONS list in exe/modootoday-check). `--check` only reports drift (exit 1); test/readme_test.rb runs it in CI.
require "open3"
root = File.expand_path("..", __dir__)
BEGIN_M = "<!-- commands:begin (generated by script/readme-commands; do not edit) -->"
END_M = "<!-- commands:end -->"
table, st = Open3.capture2(RbConfig.ruby, File.join(root, "exe/modootoday-check"), "--help=markdown")
abort "modootoday-check --help=markdown failed" unless st.success?
block = "#{BEGIN_M}\n#{table}#{END_M}"
drift = []
%w[README.md README.ko.md].each do |name|
  path = File.join(root, name)
  src = File.read(path)
  re = /#{Regexp.escape(BEGIN_M)}\n.*?#{Regexp.escape(END_M)}/m
  abort "#{name}: commands markers missing" unless src.match?(re)
  out = src.sub(re) { block }
  next if out == src
  drift << name
  File.write(path, out) unless ARGV.include?("--check")
end
if ARGV.include?("--check") && drift.any?
  warn "README commands table out of date in #{drift.join(', ')}: run script/readme-commands"
  exit 1
end
puts drift.empty? ? "README commands tables up to date" : "updated #{drift.join(', ')}"
