#!/usr/bin/env ruby
# frozen_string_literal: true

# Writes _includes/modootoday/version.html (sets mt_version) from spec.version in the gemspec.
# Liquid cannot read the gemspec, and a remote_theme build has no gem to ask. Usage: script/version-include [--check]
ROOT = File.expand_path("..", __dir__)
OUT = File.join(ROOT, "_includes/modootoday/version.html")
version = File.read(File.join(ROOT, "jekyll-theme-modootoday.gemspec"))[/spec\.version\s*=\s*"([^"]+)"/, 1] or abort "gemspec: no spec.version"
text = <<~LIQUID
  {%- comment -%}Generated by script/version-include from the gemspec; do not edit. Sets mt_version.{%- endcomment -%}
  {%- assign mt_version = "#{version}" -%}
LIQUID
if ARGV.include?("--check")
  abort "#{OUT} is stale: run script/version-include" unless File.exist?(OUT) && File.read(OUT) == text
else
  File.write(OUT, text)
end
