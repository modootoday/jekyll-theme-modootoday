#!/usr/bin/env ruby
# frozen_string_literal: true

# Docs site generator: one source of truth (docs/_data/sections.yml + each page's front matter).
# Writes docs/_data/nav/main*.yml, the page list in each section index, lang: and permalink: in each translation
# (guides/install.ko.md), and under docs/generated/ the .md.txt twin stubs and the llms.txt / llms-full.txt stubs.
# For the demos moved into published starters (the done waves of the docs demo to starter map): the redirect stubs at
# their paths and docs/_data/starters.yml, read by docs/_includes/live-demo.html. Needs the starter submodules.
# For pages moved inside docs/ (moved_from: in the English page): a redirect stub at each old path, in every language.
# From CHANGELOG.md: docs/_data/releases.yml and the release list on the reference/changelog pages.
#   ruby script/docs-index                 write
#   ruby script/docs-index --check         fail if anything is out of date (CI)
#   ruby script/docs-index --stamp PATH... record that each translation now follows its source (source_rev:)
require "fileutils"
require_relative "docs/tree"
require_relative "docs/outputs"

tree = DocsIndex::Tree.new(File.expand_path("../docs", __dir__))
out = DocsIndex::Outputs.new(tree)
if ARGV.first == "--stamp"
  paths = ARGV.drop(1).map { |p| File.expand_path(p) }
  abort "usage: ruby script/docs-index --stamp docs/guides/install.ko.md ..." if paths.empty?
  begin
    stamped = out.translations.stamp(paths)
  rescue ArgumentError => e
    abort "docs-index: #{e.message}"
  end
  stamped.each { |p, body| File.write(p, body) }
  puts "docs-index: #{stamped.size} stamped; run ruby script/docs-index to update the generated files"
  exit 0
end
stale = out.files.reject { |path, body| File.exist?(path) && File.read(path) == body }.keys
orphans = out.orphans
if ARGV.include?("--check")
  (stale + orphans).each { |p| warn "docs-index: out of date: #{p.delete_prefix("#{tree.root}/")}" }
  warn "docs-index: run ruby script/docs-index" unless (stale + orphans).empty?
  exit((stale + orphans).empty? ? 0 : 1)
end
stale.each do |p|
  FileUtils.mkdir_p(File.dirname(p))
  File.write(p, out.files[p])
end
orphans.each { |p| File.delete(p) }
puts "docs-index: #{stale.size} written, #{orphans.size} removed"
