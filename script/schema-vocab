#!/usr/bin/env ruby
# frozen_string_literal: true

# Refreshes lib/modootoday/schema/vocab.txt (schema.org type and property names) from a schema.org release
# file. The checker reads only vocab.txt, so CI never contacts schema.org.
#   curl -sSLo /tmp/s.jsonld https://schema.org/version/latest/schemaorg-current-https.jsonld
#   script/schema-vocab /tmp/s.jsonld
require "json"

src = ARGV[0] or abort "usage: script/schema-vocab FILE.jsonld"
graph = JSON.parse(File.read(src))["@graph"]
names = graph.filter_map do |n|
  id = n["@id"].to_s
  next unless id.start_with?("schema:")

  types = Array(n["@type"])
  kind = if types.include?("rdf:Property") then "p"
         elsif types.include?("rdfs:Class") || types.include?("schema:DataType") then "t"
         end
  kind && "#{kind} #{id.delete_prefix('schema:')}"
end
out = File.expand_path("../lib/modootoday/schema/vocab.txt", __dir__)
File.write(out, "# schema.org vocabulary; t type, p property. Generated by script/schema-vocab.\n#{names.uniq.sort.join("\n")}\n")
puts "#{out}: #{names.uniq.size} names"
