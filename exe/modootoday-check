#!/usr/bin/env ruby
# md-components v1 — jekyll-theme-modootoday checker (Ruby stdlib only)
# Usage: modootoday-check SRC_DIR SITE_DIR [--twins] [--github-pages[=VERSION]] [--gh] [--strict]
require "open3"
require "yaml"
require "date"
USAGE = "usage: modootoday-check SRC SITE [--twins] [--github-pages[=VERSION]] [--gh] [--strict]"
# Single source for --help and the README "Commands" table (script/readme-commands, test/readme_test.rb).
OPTIONS = [
  ["SRC SITE", "always: front matter, forbidden syntax, alerts, fence info strings, `status:`/`tag:`/`since:`/`kbd:` values, `sections:` count, `_data/components.yml`, Sass/CSS rules, unconverted markers in the build"],
  ["--twins", "every page has a byte-identical Markdown twin, per-language `llms.txt` and `llms-full.txt`"],
  ["--github-pages[=VERSION]", "`Gemfile.lock` pins `github-pages` VERSION (default 232)"],
  ["--strict", "warnings fail the run"],
  ["--gh", "also render each page with `gh api markdown` (network, `gh` login)"],
  ["--help, -h", "print usage and options (`--help=markdown` prints the README table)"],
  ["--version", "print the rules version"],
].freeze
if (h = ARGV.find { |a| a == "-h" || a.start_with?("--help") })
  if h == "--help=markdown"
    puts "| Option | Checks |", "|---|---|"
    OPTIONS.each { |o, d| puts "| `#{o}` | #{d.gsub("|", "\\|")} |" }
  else
    puts USAGE, "", "options:"
    OPTIONS.each { |o, d| puts format("  %-26s %s", o, d.delete("`")) }
    puts "", "exit status: 0 no problems, 1 problems found or bad usage"
  end
  exit 0
end
if ARGV.include?("--version")
  puts "modootoday-check (md-components v1)"
  exit 0
end
pos = ARGV.reject { |a| a.start_with?("--") }
src, site = pos[0]&.chomp("/"), pos[1]&.chomp("/")
abort USAGE unless src && site
errs = []
warns = []
KNOWN = %w[NOTE TIP IMPORTANT WARNING CAUTION].freeze
MARKS = /\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]/i
STATUS = %w[available partial planned].freeze
skip = %r{(^|/)(_site|_includes|_layouts|_data|vendor|node_modules)/}
mds = Dir.glob("#{src}/**/*.md").reject { |f| f.delete_prefix(src) =~ skip }.sort
FM = /\A---\r?\n(.*?\r?\n)?---\r?\n/m
def fm(t) = (m = t[FM]) ? (YAML.safe_load(m.sub(/\A---\r?\n/, "").sub(/---\r?\n\z/, ""), permitted_classes: [Date, Time]) || {}) : {}
def body(t) = t.sub(FM, "")
FENCE_OPEN = /^( {0,3})(`{3,}|~{3,})(.*)$/
# Blank out fenced code (CommonMark: closing fence = same char, length >= opener), keep line count.
# Yields [line_no, info_string] for every opening fence.
def strip_fences(t)
  out = []
  close = nil
  t.each_line.with_index(1) do |l, n|
    if close
      close = nil if l =~ /^ {0,3}#{Regexp.escape(close[0])}{#{close.size},}\s*$/
      out << "\n"
    elsif (m = l.match(FENCE_OPEN)) && !(m[2].start_with?("`") && m[3].include?("`"))
      close = m[2]
      yield n, m[3].strip if block_given?
      out << "\n"
    else
      out << l
    end
  end
  out.join
end
def strip_code(t) = strip_fences(t).gsub(/(`+)(?!`).+?(?<!`)\1(?!`)/) { "``" }
def strip_comments(t) = t.gsub(/<!--.*?-->/m) { |m| "\n" * m.count("\n") }
rel = ->(f) { f.delete_prefix("#{src}/") }

# Slot contract (1.x): named, stable parts of a section's Markdown. Detection is structural and
# mirrors what md-sections.html and the component scripts consume; markup does not change.
SLOTS = {
  "lead" => ->(m) { m.split(/\n\s*\n/).reject { |p| p.strip.empty? }.take_while { |p| p !~ /\A\s*([-*+]\s|\d+[.)]\s|###|```|~~~|>)/ }.count { |p| p =~ /\S/ && p !~ /\A\s*(\[[^\]]+\]\([^)]*\)\s*)+\z/ } },
  "items" => ->(m) { m.scan(/^([-*+]|\d+[.)])\s/).size },
  "panels" => ->(m) { m.scan(/^###(?: |$)/).size },
  "actions" => ->(m) { m.scan(/^(?:\[[^\]\n]+\]\([^)\n]*\)[ \t]*)+$/).size },
  "code" => ->(_m, raw) { n = 0; strip_fences(raw) { n += 1 }; n },
  "figures" => ->(m) { m.scan(/^!\[[^\]\n]+\]\([^)\n]+\)/).size },
}.freeze
comps_file = "#{src}/_data/components.yml"
comps = File.exist?(comps_file) ? (YAML.safe_load(File.read(comps_file)) || {}) : nil
slot_contract = lambda do |file, i, c, slots, md|
  next if slots.nil?
  next errs << "#{file}: _data/components.yml #{c}.slots must be a map of slot name -> {required, min, max}" unless slots.is_a?(Hash)
  slots.each do |name, rule|
    det = SLOTS[name]
    next errs << "_data/components.yml: #{c}.slots: unknown slot '#{name}' (known: #{SLOTS.keys.join(', ')})" unless det
    rule = {} unless rule.is_a?(Hash)
    m, raw = md || ["", ""]
    n = det.arity == 2 ? det.call(m, raw) : det.call(m)
    min = rule["min"] || (rule["required"] ? 1 : nil)
    errs << "#{file}: sections[#{i}] #{c}: slot '#{name}' has #{n} item(s), needs at least #{min}" if min && n < min
    errs << "#{file}: sections[#{i}] #{c}: slot '#{name}' has #{n} item(s), allows at most #{rule['max']}" if rule["max"] && n > rule["max"]
  end
end
i18n = Dir.glob("#{src}/_data/i18n/*.yml").to_h { |f| [File.basename(f, ".yml"), YAML.safe_load(File.read(f)) || {}] }
dig = ->(h, key) { key.split(".").reduce(h) { |a, k| a.is_a?(Hash) ? a[k] : nil } }

cfg_file = "#{src}/_config.yml"
site_cfg = (File.exist?(cfg_file) && ((YAML.safe_load(File.read(cfg_file), permitted_classes: [Date, Time]) rescue nil) || {})) || {}
mtc = site_cfg["modootoday"] || {}
# modootoday.twins: source = front-matter-less mode: a page without front matter is rendered by
# jekyll-optional-front-matter AND copied raw to its own path, which then is its twin.
# directories listed in the site's exclude: are not pages (e.g. a nested example site)
excl = Array(site_cfg["exclude"]).map { |e| e.to_s.chomp("/") }.select { |e| File.directory?("#{src}/#{e}") }
mds.reject! { |f| excl.any? { |e| f.start_with?("#{src}/#{e}/") } }
SOURCE_MODE = mtc.is_a?(Hash) && mtc["twins"] == "source"
if SOURCE_MODE
  of = site_cfg["optional_front_matter"] || {}
  errs << "_config.yml: modootoday.twins: source needs the raw copies; remove optional_front_matter.remove_originals" if of.is_a?(Hash) && of["remove_originals"] == true
  errs << "_config.yml: modootoday.twins: source conflicts with require_front_matter: true" if site_cfg["require_front_matter"] == true
end
mds.each do |f|
  text = File.read(f)
  b = body(text)
  # 0. every content page needs front matter (may be empty "---\n---"); without it,
  #    GitHub Pages (jekyll-optional-front-matter) renders the page AND copies the raw .md to _site.
  errs << "#{rel[f]}: missing front matter (add an empty '---' / '---' block at the top)" unless (text.start_with?("---\n") && text =~ FM) || SOURCE_MODE
  # 1a. code fence info string: one language word only (kramdown 2.4 turns "sh {x}" into inline code)
  strip_fences(b) do |n, info|
    next if info.empty? || info.match?(/\A[\w#+.-]+\z/)
    errs << "#{rel[f]}:#{n}: code fence info string must be a single language word (got #{info.inspect}); attributes like {title=…} break kramdown"
  end
  code = strip_code(b)
  lines = code.lines
  # 1b. alerts (GitHub extension): case-insensitive markers, registered types only
  lines.each_with_index do |l, i|
    n = i + 1
    errs << "#{rel[f]}:#{n}: tab after '>' (kramdown reads it as an indented code block); use a space" if l =~ /^ {0,3}>\t/
    if l =~ /^ {0,3}> ?\*{1,2}\[!\w+\]/
      errs << "#{rel[f]}:#{n}: formatted alert marker (e.g. **[!NOTE]**) is not an alert anywhere; write > [!NOTE]"
    end
    if l =~ /^ {0,3}> ?\[! +\w+\]/
      warns << "#{rel[f]}:#{n}: '[! TYPE]' with a space is not an alert (renders as a plain quote)"
    end
    next unless (m = l.match(/^ {0,3}> ?\[!(\w+)\](.*)$/))
    t, after = m[1], m[2]
    next errs << "#{rel[f]}:#{n}: unregistered alert type [!#{t}] (allowed: #{KNOWN.join('/')}; any case)" unless KNOWN.include?(t.upcase)
    errs << "#{rel[f]}:#{n}: text after [!#{t}] (custom titles are not supported; GitHub shows a plain quote)" unless after.strip.empty?
    nxt = lines[i + 1].to_s
    rest = lines[(i + 1)..].to_a.take_while { |x| x.strip != "" }
    if rest.all? { |x| x.sub(/^ {0,3}>/, "").strip.empty? }
      errs << "#{rel[f]}:#{n}: empty alert [!#{t}] (GitHub shows a plain quote); add body text"
    end
  end
  # 1c. forbidden syntax outside code
  html_free = strip_comments(code)
  errs << "#{rel[f]}: HTML comment <!-- --> (hidden on GitHub, emitted by kramdown); remove it" if code.include?("<!--")
  html_free.each_line.with_index(1) do |l, n|
    linkless = l.gsub(/\]\([^)]*\)/, "]()").gsub(/<(https?:|mailto:)[^>]*>|<[^@\s>]+@[^>\s]+>/, "<>").sub(/^ {0,3}\[[^\]]+\]:\s*\S+/, "")
    why = case l
          when /<\/?[a-zA-Z][\w-]*[\s>\/]/ then "raw HTML (not portable: GitHub renders some tags, strips others; kramdown passes all through)"
          when /\{%|\{\{/ then "Liquid"
          when /\{:/ then "kramdown IAL/ALD"
          when /\{#[\w-]+\}/ then "{#id} header id"
          when /^:\s/ then "definition list"
          when /^\*\[[^\]]+\]:/ then "abbreviation definition *[X]: (kramdown-only)"
          when /^\s*([-*+]|\d+\.|\|).*\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]/i, /^\s*(>\s*){2,}\[!/
            "alert nested in list/table/quote (GitHub renders only top-level alerts; this shows as a plain quote); start '> [!TYPE]' at column 0"
          end
    why ||= "bare URL/e-mail autolink (kramdown does not link it); write <https://…> or [text](url)" if linkless =~ %r{(?<![<\w/@.])(https?://|www\.)\S|(?<![<\w.+-])[\w.+-]+@[\w-]+\.[a-z]{2,}}i
    errs << "#{rel[f]}:#{n}: #{why}" if why
  end
  h2 = 0
  prev = ""
  list = false # inside a list item (last column-0 block started with a list marker)
  html_free.each_line.with_index(1) do |l, n|
    list = l =~ /^([-*+]|\d+[.)])\s/ ? true : false if l =~ /^\S/
    msg = case l
          when /^##( |$)/ then (h2 += 1; nil)
          when /^\s+##( |$)/ then
            if list then "'##' inside a list item is not a section (sections split only on column-0 '## '); use '###' or move it out of the list"
            elsif l =~ /^ {1,3}#/ then "indented '##' (kramdown: paragraph, GitHub: heading); start at column 0"
            end
          when /^\s+> ?\[!\w+\]/ then list ? "alert nested in list/table/quote (GitHub renders only top-level alerts; this shows as a plain quote); start '> [!TYPE]' at column 0" : nil
          when /^\s*(>\s*)+##( |$)/ then "'##' inside a quote/alert is not a section (sections split only on column-0 '## '; GitHub would show an h2 inside the box); use '###' or bold text"
          when /^ {0,3}-+\s*$/
            if prev =~ /\S/ && prev !~ /^\s*([-*+>|#]|\d+\.)/
              n -= 1
              "setext heading (text underlined with ---) is not allowed; use '## '"
            end
          end
    errs << "#{rel[f]}:#{n}: #{msg}" if msg
    prev = l
  end
  # 2. status badge vocabulary (code spans outside fences)
  strip_fences(b).scan(/`status:([^`\s]*)`/) do |(v)|
    errs << "#{rel[f]}: unregistered status value `status:#{v}` (allowed: #{STATUS.join('/')})" unless STATUS.include?(v)
  end
  strip_fences(b).scan(/`(tag|since):([^`]*)`/) do |(k, v)|
    errs << "#{rel[f]}: `#{k}:#{v}` badge value must be one token [A-Za-z0-9._-]" unless v =~ /\A[A-Za-z0-9._-]+\z/
  end
  strip_fences(b).scan(/`kbd:([^`]*)`/) do |(v)|
    errs << "#{rel[f]}: `kbd:#{v}` must be keys joined by '+' without spaces (e.g. `kbd:Ctrl+K`)" unless v =~ /\A[^\s+]+(\+[^\s+]+)*\z/
  end
  errs << "#{rel[f]}: image without alt text (![](...)); write ![description](...)" if strip_fences(b).gsub(/`[^`\n]*`/, "") =~ /!\[\s*\]\(/
  # 3. sections: count == number of ## headings
  meta = begin fm(text) rescue (errs << "#{rel[f]}: front matter YAML error"; {}) end
  secs = meta["sections"]
  next unless secs
  next errs << "#{rel[f]}: sections: must be a list" unless secs.is_a?(Array)
  code.scan(/<!--.*?-->/m) { |c| errs << "#{rel[f]}: '##' inside an HTML comment is not a heading" if c =~ /^##/ }
  errs << "#{rel[f]}: sections: has #{secs.size} item(s) but body has #{h2} top-level '## ' heading(s)" if secs.size != h2
  # 4. optional components registry
  next unless comps
  # Markdown of each top-level ## section (index i = sections[i]); code spans/fences already blanked in `code`
  bl = b.lines
  cl = code.lines
  starts = cl.each_index.select { |k| cl[k] =~ /^##(?: |$)/ }
  sec_md = starts.each_with_index.map do |st, k|
    raw = bl[st + 1...(starts[k + 1] || bl.size)].to_a.join
    [cl[st + 1...(starts[k + 1] || cl.size)].to_a.join, raw]
  end
  secs.each_with_index do |s, i|
    next unless s.is_a?(Hash) && s["c"]
    spec = comps[s["c"]]
    next errs << "#{rel[f]}: sections[#{i}] unknown component '#{s['c']}' (not in _data/components.yml)" unless spec
    params = spec["params"] || {}
    slot_contract.call(rel[f], i, s["c"], spec["slots"], sec_md[i])
    (s.keys - %w[c name]).each do |k|
      next errs << "#{rel[f]}: sections[#{i}] #{s['c']}: unknown param '#{k}'" unless params.key?(k)
      allowed = params[k].is_a?(Hash) && params[k]["allowed"]
      errs << "#{rel[f]}: sections[#{i}] #{s['c']}.#{k}=#{s[k].inspect} not in #{allowed.inspect}" if allowed && !allowed.include?(s[k])
    end
    params.each do |k, p|
      errs << "#{rel[f]}: sections[#{i}] #{s['c']}: missing required param '#{k}'" if p.is_a?(Hash) && p["required"] && !s.key?(k)
    end
  end
end
if comps
  comps.each do |name, spec|
    Array(spec && spec["i18n"]).each do |key|
      i18n.each { |lang, h| errs << "_data/i18n/#{lang}.yml: missing key '#{key}' (component #{name})" if dig[h, key].nil? }
    end
  end
end

# 5. build residue
Dir.glob("#{site}/**/*.html").each do |f|
  t = File.read(f)
  t = t.gsub(%r{<pre\b.*?</pre>}m, "").gsub(%r{<code\b.*?</code>}m) { |c| c.include?("status:") ? c : "" }
  t.scan(MARKS) { errs << "#{f}: unconverted alert marker [!#{$1}]" }
  errs << "#{f}: unconverted status badge (<code>status:)" if t =~ /<code[^>]*>status:/
end

# 5b. Sass/CSS portability (github-pages = Ruby Sass 3.7: @use/@forward pass through silently,
#     @supports selector() is a syntax error) and token references.
SASS_BAD = [[/^\s*@(use|forward)\b/, "@use/@forward (Ruby Sass on GitHub Pages copies it into the CSS untouched); use @import"],
            [/@supports\s+(not\s+)?selector\(/, "@supports selector() (Ruby Sass syntax error on GitHub Pages)"]].freeze
Dir.glob(["#{src}/_sass/**/*.scss", "#{src}/assets/**/*.scss"]).reject { |f| f.delete_prefix(src) =~ skip }.sort.each do |f|
  File.read(f).gsub(%r{/\*.*?\*/}m) { |c| "\n" * c.count("\n") }.each_line.with_index(1) do |l, n|
    l = l.sub(%r{//.*}, "")
    SASS_BAD.each { |re, why| errs << "#{rel[f]}:#{n}: #{why}" if l =~ re }
    # md-* aliases: deprecated, removed in 2.0 (the theme's own partials keep them until then)
    if f !~ %r{/_sass/modootoday(/|\.scss\z)} && l =~ /(--md-[a-z]|\.md-[a-z])/
      warns << "#{rel[f]}:#{n}: md-* alias is deprecated (removed in 2.0); use the --mt-*/mt-* name"
    end
  end
end
# 5c. md-* aliases in the site's own markup and CSS (classes and var(--md-*)); code is ignored
MD_ALIAS = /(class=["'][^"']*(?<![\w-])md-[a-z]|var\(\s*--md-[a-z])/
md_alias_files = Dir.glob(["#{src}/_includes/**/*.html", "#{src}/_layouts/**/*.html", "#{src}/assets/**/*.css"]) +
                 Dir.glob(["#{src}/**/*.md", "#{src}/**/*.html"]).reject { |f| f.delete_prefix(src) =~ skip }
md_alias_files.uniq.reject { |f| f.delete_prefix(src) =~ %r{(^|/)(_site|vendor|node_modules)/} }.sort.each do |f|
  t = File.read(f)
  t = strip_comments(f.end_with?(".md") ? strip_code(t) : t)
  t.each_line.with_index(1) do |l, n|
    warns << "#{rel[f]}:#{n}: md-* alias is deprecated (removed in 2.0); use the --mt-*/mt-* name" if l =~ MD_ALIAS
  end
end
css = Dir.glob("#{site}/**/*.css").sort
defined = {}
css.each do |f|
  t = File.read(f)
  errs << "#{f}: @use/@forward left in built CSS (Ruby Sass passes them through); use @import" if t =~ /@(use|forward)\s/
  errs << "#{f}: @supports selector() in built CSS" if t =~ /@supports\s+(not\s+)?selector\(/
  errs << "#{f}: custom property with a literal Sass variable (write --x: \#{$var})" if t =~ /--[\w-]+:\s*\$/
  t.scan(/(--mt-[\w-]+)\s*:/) { defined[$1] = true }
end
Dir.glob("#{site}/**/*.html").each { |f| File.read(f).scan(%r{<style[^>]*>(.*?)</style>}m) { $1.scan(/(--mt-[\w-]+)\s*:/) { defined[$1] = true } } }
css.each do |f|
  File.read(f).scan(/var\((--mt-[\w-]+)/).flatten.uniq.each do |v|
    errs << "#{f}: var(#{v}) is never defined" unless defined[v]
  end
end

# 5c. modootoday: settings in the site _config.yml
COMPONENTS = %w[callout badge hero cta card tabs code-copy nav pagination theme-toggle breadcrumb toc accordion steps figure timeline kbd search].freeze
SEMANTIC = %w[background foreground muted muted-foreground card card-foreground primary primary-foreground brand accent
              accent-foreground border ring note tip important warning caution status-available status-partial
              status-planned font-sans font-mono font-size line-height measure space radius].freeze
if mtc.is_a?(Hash)
  if mtc.key?("twins") && ![true, false, "source"].include?(mtc["twins"])
    errs << "_config.yml: modootoday.twins must be true, false or source (got #{mtc['twins'].inspect})"
  end
  if mtc.key?("color_scheme") && !%w[auto light dark].include?(mtc["color_scheme"])
    errs << "_config.yml: modootoday.color_scheme must be auto, light or dark (got #{mtc['color_scheme'].inspect})"
  end
  if mtc.key?("csp") && mtc["csp"] != "strict" && mtc["csp"] != false
    errs << "_config.yml: modootoday.csp must be strict or false (got #{mtc['csp'].inspect})"
  end
  if mtc.key?("languages") && !(mtc["languages"].is_a?(Array) && mtc["languages"].all? { |l| l.to_s =~ /\A[a-z]{2,3}(-[A-Za-z0-9]+)*\z/ })
    errs << "_config.yml: modootoday.languages must be a list of language codes such as [en, ko]"
  end
  if mtc.key?("edit_url") && mtc["edit_url"].to_s !~ %r{\Ahttps?://\S+/\z}
    errs << "_config.yml: modootoday.edit_url must be an http(s) URL ending in / (page.path is appended)"
  end
  if mtc["feed"] == true && !Array(site_cfg["plugins"]).map(&:to_s).include?("jekyll-feed")
    warns << "_config.yml: modootoday.feed: true links /feed.xml; add jekyll-feed to plugins"
  end
  %w[css_layers badges seo feed].each do |k|
    errs << "_config.yml: modootoday.#{k} must be true or false" if mtc.key?(k) && ![true, false].include?(mtc[k])
  end
  if mtc.key?("components")
    list = mtc["components"]
    next_list = list.is_a?(Array) ? list : (errs << "_config.yml: modootoday.components must be a list"; [])
    (next_list.map(&:to_s) - COMPONENTS).each { |c| errs << "_config.yml: modootoday.components: unknown component '#{c}' (known: #{COMPONENTS.join(', ')})" }
  end
  %w[tokens tokens_dark].each do |k|
    next unless mtc.key?(k)
    next errs << "_config.yml: modootoday.#{k} must be a map" unless mtc[k].is_a?(Hash)
    mtc[k].each do |name, val|
      warns << "_config.yml: modootoday.#{k}.#{name}: not a semantic token (#{SEMANTIC.join(', ')})" unless SEMANTIC.include?(name.to_s)
      v = val.to_s.strip
      if v.empty? || v =~ /[;{}<>]/ || v !~ /\A[#\w\s.,%()"'+\-*\/]+\z/
        errs << "_config.yml: modootoday.#{k}.#{name}: invalid CSS value #{val.inspect}"
      elsif v.start_with?("#") && v !~ /\A#(\h{3}|\h{4}|\h{6}|\h{8})\z/
        errs << "_config.yml: modootoday.#{k}.#{name}: invalid hex color #{val.inspect}"
      end
    end
  end
elsif mtc
  errs << "_config.yml: modootoday: must be a map"
end

# 6. optional: github-pages pin (--github-pages[=VERSION], default 232 or $MODOOTODAY_GITHUB_PAGES)
if (gp = ARGV.find { |a| a == "--github-pages" || a.start_with?("--github-pages=") })
  want = gp.include?("=") ? gp.split("=", 2)[1] : ENV.fetch("MODOOTODAY_GITHUB_PAGES", "232")
  lock = "#{src}/Gemfile.lock" # the site's own lockfile wins; else the active bundle's lockfile
  lock = "#{ENV['BUNDLE_GEMFILE']}.lock" if !File.exist?(lock) && ENV["BUNDLE_GEMFILE"] && File.exist?("#{ENV['BUNDLE_GEMFILE']}.lock")
  if File.exist?(lock) && (v = File.read(lock)[/^    github-pages \((\d+)\)/, 1])
    errs << "#{lock}: github-pages #{v} != #{want}" unless v == want
  else
    errs << "--github-pages: no Gemfile.lock with github-pages found (#{lock})"
  end
end

# 7. twins: every Markdown page (except README.md and `twin: false`) has /<page>/index.md
#    (/index.md for index.md), byte-identical to its source body. It comes from a stub <name>.md.txt
#    (layout: twin; works on GitHub Pages) or from the opt-in plugin (plugins: [jekyll-theme-modootoday]).
#    With modootoday.twins: source, a page without front matter is its own twin at /<path>.md.
#    llms.txt / llms-full.txt exist at / and at each /<lang>/; llms-full.txt contains every page body.
if ARGV.include?("--twins")
  hint = "add a stub #{"%s"} (front matter `layout: twin`, `twin_of`, `permalink`) or enable `plugins: [jekyll-theme-modootoday]` (not on classic GitHub Pages)"
  bodies = Hash.new { |h, k| h[k] = [] }
  mds.each do |f|
    stub = "#{f}.txt"
    if File.exist?(stub)
      st = File.read(stub)
      meta = (fm(st) rescue {})
      errs << "#{rel[stub]}: stub must set layout: twin" unless meta["layout"] == "twin"
      errs << "#{rel[stub]}: stub body must be empty" unless body(st).strip.empty?
    end
    next if File.basename(f) == "README.md" || (fm(File.read(f)) rescue {})["twin"] == false
    r = rel[f].delete_suffix(".md")
    if SOURCE_MODE && File.read(f) !~ FM
      # front-matter-less mode: rendered page + raw copy of the whole source at its own path
      errs << "#{rel[f]}.txt: redundant stub in twins: source mode (the source is already the twin); delete it" if File.exist?(stub)
      raw = "#{site}/#{rel[f]}"
      html = ["#{site}/#{r}.html", "#{site}/#{r}/index.html"]
      lang = r.split("/").first if r.include?("/") && i18n.key?(r.split("/").first)
      bodies[lang.to_s] << [rel[f], File.read(f)]
      errs << "#{rel[f]}: no rendered page (#{html.map { |h| h.delete_prefix("#{site}/") }.join(' or ')}); is jekyll-optional-front-matter enabled? (local builds: list it in plugins:)" unless html.any? { |h| File.exist?(h) }
      next errs << "#{rel[f]}: raw copy missing at #{raw} (optional_front_matter.remove_originals must not be true)" unless File.exist?(raw)
      next errs << "#{raw}: raw copy is not byte-identical to #{rel[f]}" unless File.binread(raw) == File.binread(f)
      next
    end
    out = File.basename(r) == "index" ? "#{site}/#{r}.md" : "#{site}/#{r}/index.md"
    b = body(File.read(f))
    lang = r.split("/").first if r.include?("/") && i18n.key?(r.split("/").first)
    bodies[lang.to_s] << [rel[f], b]
    next errs << "#{rel[f]}: twin missing at #{out}: #{format(hint, "#{rel[f]}.txt")}" unless File.exist?(out)
    errs << "#{out}: twin is not byte-identical to the body of #{rel[f]}" unless File.binread(out) == b.b
  end
  langs = [""] + i18n.keys.select { |l| Dir.exist?("#{src}/#{l}") }
  langs.each do |l|
    %w[llms.txt llms-full.txt].each do |n|
      p = [site, l, n].reject(&:empty?).join("/")
      next errs << "#{p}: missing (per-language llms file; stub with `layout: #{n.delete_suffix('.txt')}` or the plugin)" unless File.exist?(p)
      txt = File.read(p)
      if n == "llms.txt"
        errs << "#{p}: must start with an H1 (llmstxt.org)" unless txt.start_with?("# ")
      else
        bodies[l].each { |(name, b)| errs << "#{p}: does not contain the body of #{name}" unless b.strip.empty? || txt.include?(b.strip) }
      end
    end
  end
end

if ARGV.include?("--gh") # optional: GitHub render, needs gh auth + network
  mds.each do |f|
    out, st = Open3.capture2("gh", "api", "markdown", "-f", "mode=gfm", "-f", "text=#{body(File.read(f))}")
    next errs << "#{rel[f]}: gh api failed" unless st.success?
    errs << "#{rel[f]}: GitHub shows ': ' definition marker" if out =~ /<p>: /
  end
end
errs.concat(warns.map { |w| "#{w} [strict]" }) if ARGV.include?("--strict")
warns.each { |w| warn "warning: #{w}" } unless ARGV.include?("--strict")
puts errs
puts errs.empty? ? "md-components check: OK (#{mds.size} pages)" : "md-components check: #{errs.size} problem(s)"
exit(errs.empty? ? 0 : 1)
