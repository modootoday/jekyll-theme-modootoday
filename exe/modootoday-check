#!/usr/bin/env ruby
# md-components v1 (draft) — jekyll-theme-modootoday checker (Ruby stdlib only)
# Usage: modootoday-check SRC_DIR SITE_DIR [--twins] [--github-pages[=VERSION]] [--gh] [--strict]
require "open3"
require "yaml"
require "date"
USAGE = "usage: modootoday-check SRC SITE [--twins] [--github-pages[=VERSION]] [--gh] [--strict]"
if ARGV.include?("-h") || ARGV.include?("--help")
  puts USAGE
  exit 0
end
if ARGV.include?("--version")
  puts "modootoday-check (md-components v1 draft)"
  exit 0
end
pos = ARGV.reject { |a| a.start_with?("--") }
src, site = pos[0]&.chomp("/"), pos[1]&.chomp("/")
abort USAGE unless src && site
errs = []
warns = []
KNOWN = %w[NOTE TIP IMPORTANT WARNING CAUTION].freeze
MARKS = /\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]/i
STATUS = %w[available partial planned].freeze
skip = %r{(^|/)(_site|_includes|_layouts|_data|vendor|node_modules)/}
mds = Dir.glob("#{src}/**/*.md").reject { |f| f.delete_prefix(src) =~ skip }.sort
FM = /\A---\r?\n(.*?\r?\n)?---\r?\n/m
def fm(t) = (m = t[FM]) ? (YAML.safe_load(m.sub(/\A---\r?\n/, "").sub(/---\r?\n\z/, ""), permitted_classes: [Date, Time]) || {}) : {}
def body(t) = t.sub(FM, "")
FENCE_OPEN = /^( {0,3})(`{3,}|~{3,})(.*)$/
# Blank out fenced code (CommonMark: closing fence = same char, length >= opener), keep line count.
# Yields [line_no, info_string] for every opening fence.
def strip_fences(t)
  out = []
  close = nil
  t.each_line.with_index(1) do |l, n|
    if close
      close = nil if l =~ /^ {0,3}#{Regexp.escape(close[0])}{#{close.size},}\s*$/
      out << "\n"
    elsif (m = l.match(FENCE_OPEN)) && !(m[2].start_with?("`") && m[3].include?("`"))
      close = m[2]
      yield n, m[3].strip if block_given?
      out << "\n"
    else
      out << l
    end
  end
  out.join
end
def strip_code(t) = strip_fences(t).gsub(/(`+)(?!`).+?(?<!`)\1(?!`)/) { "``" }
def strip_comments(t) = t.gsub(/<!--.*?-->/m) { |m| "\n" * m.count("\n") }
rel = ->(f) { f.delete_prefix("#{src}/") }

comps_file = "#{src}/_data/components.yml"
comps = File.exist?(comps_file) ? (YAML.safe_load(File.read(comps_file)) || {}) : nil
i18n = Dir.glob("#{src}/_data/i18n/*.yml").to_h { |f| [File.basename(f, ".yml"), YAML.safe_load(File.read(f)) || {}] }
dig = ->(h, key) { key.split(".").reduce(h) { |a, k| a.is_a?(Hash) ? a[k] : nil } }

mds.each do |f|
  text = File.read(f)
  b = body(text)
  # 0. every content page needs front matter (may be empty "---\n---"); without it,
  #    GitHub Pages (jekyll-optional-front-matter) renders the page AND copies the raw .md to _site.
  errs << "#{rel[f]}: missing front matter (add an empty '---' / '---' block at the top)" unless text.start_with?("---\n") && text =~ FM
  # 1a. code fence info string: one language word only (kramdown 2.4 turns "sh {x}" into inline code)
  strip_fences(b) do |n, info|
    next if info.empty? || info.match?(/\A[\w#+.-]+\z/)
    errs << "#{rel[f]}:#{n}: code fence info string must be a single language word (got #{info.inspect}); attributes like {title=…} break kramdown"
  end
  code = strip_code(b)
  lines = code.lines
  # 1b. alerts (GitHub extension): case-insensitive markers, registered types only
  lines.each_with_index do |l, i|
    n = i + 1
    errs << "#{rel[f]}:#{n}: tab after '>' (kramdown reads it as an indented code block); use a space" if l =~ /^ {0,3}>\t/
    if l =~ /^ {0,3}> ?\*{1,2}\[!\w+\]/
      errs << "#{rel[f]}:#{n}: formatted alert marker (e.g. **[!NOTE]**) is not an alert anywhere; write > [!NOTE]"
    end
    if l =~ /^ {0,3}> ?\[! +\w+\]/
      warns << "#{rel[f]}:#{n}: '[! TYPE]' with a space is not an alert (renders as a plain quote)"
    end
    next unless (m = l.match(/^ {0,3}> ?\[!(\w+)\](.*)$/))
    t, after = m[1], m[2]
    next errs << "#{rel[f]}:#{n}: unregistered alert type [!#{t}] (allowed: #{KNOWN.join('/')}; any case)" unless KNOWN.include?(t.upcase)
    errs << "#{rel[f]}:#{n}: text after [!#{t}] (custom titles are not supported; GitHub shows a plain quote)" unless after.strip.empty?
    nxt = lines[i + 1].to_s
    rest = lines[(i + 1)..].to_a.take_while { |x| x.strip != "" }
    if rest.all? { |x| x.sub(/^ {0,3}>/, "").strip.empty? }
      errs << "#{rel[f]}:#{n}: empty alert [!#{t}] (GitHub shows a plain quote); add body text"
    end
  end
  # 1c. forbidden syntax outside code
  html_free = strip_comments(code)
  errs << "#{rel[f]}: HTML comment <!-- --> (hidden on GitHub, emitted by kramdown); remove it" if code.include?("<!--")
  html_free.each_line.with_index(1) do |l, n|
    linkless = l.gsub(/\]\([^)]*\)/, "]()").gsub(/<(https?:|mailto:)[^>]*>|<[^@\s>]+@[^>\s]+>/, "<>").sub(/^ {0,3}\[[^\]]+\]:\s*\S+/, "")
    why = case l
          when /<\/?[a-zA-Z][\w-]*[\s>\/]/ then "raw HTML (not portable: GitHub renders some tags, strips others; kramdown passes all through)"
          when /\{%|\{\{/ then "Liquid"
          when /\{:/ then "kramdown IAL/ALD"
          when /\{#[\w-]+\}/ then "{#id} header id"
          when /^:\s/ then "definition list"
          when /^\*\[[^\]]+\]:/ then "abbreviation definition *[X]: (kramdown-only)"
          when /^\s*([-*+]|\d+\.|\|).*\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]/i, /^\s*(>\s*){2,}\[!/
            "alert nested in list/table/quote"
          end
    why ||= "bare URL/e-mail autolink (kramdown does not link it); write <https://…> or [text](url)" if linkless =~ %r{(?<![<\w/@.])(https?://|www\.)\S|(?<![<\w.+-])[\w.+-]+@[\w-]+\.[a-z]{2,}}i
    errs << "#{rel[f]}:#{n}: #{why}" if why
  end
  h2 = 0
  prev = ""
  list = false # inside a list item (last column-0 block started with a list marker)
  html_free.each_line.with_index(1) do |l, n|
    list = l =~ /^([-*+]|\d+[.)])\s/ ? true : false if l =~ /^\S/
    msg = case l
          when /^##( |$)/ then (h2 += 1; nil)
          when /^\s+##( |$)/ then
            if list then "'##' inside a list item is not a section; use ### or move it out"
            elsif l =~ /^ {1,3}#/ then "indented '##' (kramdown: paragraph, GitHub: heading); start at column 0"
            end
          when /^\s+> ?\[!\w+\]/ then list ? "alert nested in list/table/quote" : nil
          when /^\s*(>\s*)+##( |$)/ then "'##' inside a quote/alert is not a section; use ### or move it out"
          when /^ {0,3}-+\s*$/
            if prev =~ /\S/ && prev !~ /^\s*([-*+>|#]|\d+\.)/
              n -= 1
              "setext heading (text underlined with ---) is not allowed; use '## '"
            end
          end
    errs << "#{rel[f]}:#{n}: #{msg}" if msg
    prev = l
  end
  # 2. status badge vocabulary (code spans outside fences)
  strip_fences(b).scan(/`status:([^`\s]*)`/) do |(v)|
    errs << "#{rel[f]}: unregistered status value `status:#{v}` (allowed: #{STATUS.join('/')})" unless STATUS.include?(v)
  end
  # 3. sections: count == number of ## headings
  meta = begin fm(text) rescue (errs << "#{rel[f]}: front matter YAML error"; {}) end
  secs = meta["sections"]
  next unless secs
  next errs << "#{rel[f]}: sections: must be a list" unless secs.is_a?(Array)
  code.scan(/<!--.*?-->/m) { |c| errs << "#{rel[f]}: '##' inside an HTML comment is not a heading" if c =~ /^##/ }
  errs << "#{rel[f]}: sections: has #{secs.size} item(s) but body has #{h2} top-level '## ' heading(s)" if secs.size != h2
  # 4. optional components registry
  next unless comps
  secs.each_with_index do |s, i|
    next unless s.is_a?(Hash) && s["c"]
    spec = comps[s["c"]]
    next errs << "#{rel[f]}: sections[#{i}] unknown component '#{s['c']}' (not in _data/components.yml)" unless spec
    params = spec["params"] || {}
    (s.keys - %w[c name]).each do |k|
      next errs << "#{rel[f]}: sections[#{i}] #{s['c']}: unknown param '#{k}'" unless params.key?(k)
      allowed = params[k].is_a?(Hash) && params[k]["allowed"]
      errs << "#{rel[f]}: sections[#{i}] #{s['c']}.#{k}=#{s[k].inspect} not in #{allowed.inspect}" if allowed && !allowed.include?(s[k])
    end
    params.each do |k, p|
      errs << "#{rel[f]}: sections[#{i}] #{s['c']}: missing required param '#{k}'" if p.is_a?(Hash) && p["required"] && !s.key?(k)
    end
  end
end
if comps
  comps.each do |name, spec|
    Array(spec && spec["i18n"]).each do |key|
      i18n.each { |lang, h| errs << "_data/i18n/#{lang}.yml: missing key '#{key}' (component #{name})" if dig[h, key].nil? }
    end
  end
end

# 5. build residue
Dir.glob("#{site}/**/*.html").each do |f|
  t = File.read(f)
  t = t.gsub(%r{<pre\b.*?</pre>}m, "").gsub(%r{<code\b.*?</code>}m) { |c| c.include?("status:") ? c : "" }
  t.scan(MARKS) { errs << "#{f}: unconverted alert marker [!#{$1}]" }
  errs << "#{f}: unconverted status badge (<code>status:)" if t =~ /<code[^>]*>status:/
end

# 6. optional: github-pages pin (--github-pages[=VERSION], default 232 or $MODOOTODAY_GITHUB_PAGES)
if (gp = ARGV.find { |a| a == "--github-pages" || a.start_with?("--github-pages=") })
  want = gp.include?("=") ? gp.split("=", 2)[1] : ENV.fetch("MODOOTODAY_GITHUB_PAGES", "232")
  lock = "#{src}/Gemfile.lock" # the site's own lockfile wins; else the active bundle's lockfile
  lock = "#{ENV['BUNDLE_GEMFILE']}.lock" if !File.exist?(lock) && ENV["BUNDLE_GEMFILE"] && File.exist?("#{ENV['BUNDLE_GEMFILE']}.lock")
  if File.exist?(lock) && (v = File.read(lock)[/^    github-pages \((\d+)\)/, 1])
    errs << "#{lock}: github-pages #{v} != #{want}" unless v == want
  else
    errs << "--github-pages: no Gemfile.lock with github-pages found (#{lock})"
  end
end

# 7. twins: <name>.md + stub <name>.md.txt (layout twin, empty body)
#    → /index.md for index.md, else /<dir>/<name>/index.md; byte-identical to the source body.
#    llms.txt / llms-full.txt exist at / and at each /<lang>/.
if ARGV.include?("--twins")
  mds.each do |f|
    stub = "#{f}.txt"
    next unless File.exist?(stub)
    st = File.read(stub)
    meta = (fm(st) rescue {})
    errs << "#{rel[stub]}: stub must set layout: twin" unless meta["layout"] == "twin"
    errs << "#{rel[stub]}: stub body must be empty" unless body(st).strip.empty?
    r = rel[f].delete_suffix(".md")
    out = File.basename(r) == "index" ? "#{site}/#{r}.md" : "#{site}/#{r}/index.md"
    next errs << "#{rel[f]}: twin missing at #{out}" unless File.exist?(out)
    errs << "#{out}: twin is not byte-identical to the body of #{rel[f]}" unless File.binread(out) == body(File.read(f)).b
  end
  mds.each do |f|
    next if File.exist?("#{f}.txt") || File.basename(f) == "README.md"
    errs << "#{rel[f]}: no twin stub #{rel[f]}.txt"
  end
  langs = [""] + i18n.keys.select { |l| Dir.exist?("#{src}/#{l}") }
  langs.each do |l|
    %w[llms.txt llms-full.txt].each do |n|
      p = [site, l, n].reject(&:empty?).join("/")
      errs << "#{p}: missing (per-language llms file)" unless File.exist?(p)
    end
  end
end

if ARGV.include?("--gh") # optional: GitHub render, needs gh auth + network
  mds.each do |f|
    out, st = Open3.capture2("gh", "api", "markdown", "-f", "mode=gfm", "-f", "text=#{body(File.read(f))}")
    next errs << "#{rel[f]}: gh api failed" unless st.success?
    errs << "#{rel[f]}: GitHub shows ': ' definition marker" if out =~ /<p>: /
  end
end
errs.concat(warns.map { |w| "#{w} [strict]" }) if ARGV.include?("--strict")
warns.each { |w| warn "warning: #{w}" } unless ARGV.include?("--strict")
puts errs
puts errs.empty? ? "md-components check: OK (#{mds.size} pages)" : "md-components check: #{errs.size} problem(s)"
exit(errs.empty? ? 0 : 1)
