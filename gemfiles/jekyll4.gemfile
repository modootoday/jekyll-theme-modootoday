# frozen_string_literal: true
source "https://rubygems.org"
gemspec path: ".."
gem "jekyll", "~> 4.4"
# front-matter-less twin mode (modootoday.twins: source); GitHub Pages ships both by default
gem "jekyll-optional-front-matter", "~> 0.3.2", group: :jekyll_plugins
gem "jekyll-titles-from-headings", "~> 0.5.3", group: :jekyll_plugins
# the other plugins docs/_config.yml names, at the github-pages 232 versions; loaded only by a site that names them
gem "jekyll-sitemap", "1.4.0"
gem "jekyll-relative-links", "0.6.1"
gem "webrick"
gem "minitest", ">= 5"
gem "rake"
